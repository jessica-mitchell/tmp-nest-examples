#!/usr/bin/env snakemake

"""
Snakefile for ignore_and_fire example

This workflow simulates a balanced random network with STDP synapses using
either integrate-and-fire (iaf_psc_alpha) or ignore-and-fire neurons,
and generates figures for documentation.

Usage:
    snakemake -c4    # Run with 4 cores
    snakemake        # Run with default settings
    snakemake clean  # Clean up generated files
"""

# Configuration
NEURON_MODELS = ["iaf_psc_alpha", "ignore_and_fire"]


rule all:
    """
    Runs simulations and creates all figures for the ignore-and-fire usecase documentation.
    """
    input:
        # LIF figures
        "figures/TwoPopulationNetworkPlastic_iaf_psc_alpha_spikes.png",
        "figures/TwoPopulationNetworkPlastic_iaf_psc_alpha_weight_distributions.png",
        "figures/TwoPopulationNetworkPlastic_iaf_psc_alpha_connectivity_presim.png",
        "figures/TwoPopulationNetworkPlastic_iaf_psc_alpha_connectivity_postsim.png",
        # Ignore-and-fire figures
        "figures/TwoPopulationNetworkPlastic_ignore_and_fire_spikes.png",
        "figures/TwoPopulationNetworkPlastic_ignore_and_fire_weight_distributions.png",
        "figures/TwoPopulationNetworkPlastic_ignore_and_fire_connectivity_presim.png",
        "figures/TwoPopulationNetworkPlastic_ignore_and_fire_connectivity_postsim.png",
        # Scaling figure
        "figures/scaling.png",


rule simulate_lif:
    """
    Simulate network with LIF neurons and store spikes and synaptic weights.
    """
    input:
        "model_ignore_and_fire.py",
        "parameter_dict_ignore_and_fire.py",
        "generate_reference_data_ignore_and_fire.py"
    output:
        temp(".LIF_simulation_done")
    shell:
        "python3 generate_reference_data_ignore_and_fire.py iaf_psc_alpha; touch {output}"


rule simulate_ignore_and_fire:
    """
    Simulate network with ignore-and-fire neurons and store spikes and synaptic weights.
    """
    input:
        "model_ignore_and_fire.py",
        "parameter_dict_ignore_and_fire.py",
        "generate_reference_data_ignore_and_fire.py"
    output:
        temp(".IgAF_simulation_done")
    shell:
        "python3 generate_reference_data_ignore_and_fire.py ignore_and_fire; touch {output}"


rule figures_lif:
    """
    Create figures for LIF neuron simulation.
    """
    input:
        "model_ignore_and_fire.py",
        "parameter_dict_ignore_and_fire.py",
        "generate_reference_figures_ignore_and_fire.py",
        ".LIF_simulation_done"
    output:
        "figures/TwoPopulationNetworkPlastic_iaf_psc_alpha_spikes.png",
        "figures/TwoPopulationNetworkPlastic_iaf_psc_alpha_weight_distributions.png",
        "figures/TwoPopulationNetworkPlastic_iaf_psc_alpha_connectivity_presim.png",
        "figures/TwoPopulationNetworkPlastic_iaf_psc_alpha_connectivity_postsim.png",
    shell:
        "python3 generate_reference_figures_ignore_and_fire.py iaf_psc_alpha"


rule figures_ignore_and_fire:
    """
    Create figures for ignore-and-fire neuron simulation.
    """
    input:
        "model_ignore_and_fire.py",
        "parameter_dict_ignore_and_fire.py",
        "generate_reference_figures_ignore_and_fire.py",
        ".IgAF_simulation_done"
    output:
        "figures/TwoPopulationNetworkPlastic_ignore_and_fire_spikes.png",
        "figures/TwoPopulationNetworkPlastic_ignore_and_fire_weight_distributions.png",
        "figures/TwoPopulationNetworkPlastic_ignore_and_fire_connectivity_presim.png",
        "figures/TwoPopulationNetworkPlastic_ignore_and_fire_connectivity_postsim.png",
    shell:
        "python3 generate_reference_figures_ignore_and_fire.py ignore_and_fire"


rule scaling:
    """
    Perform scaling experiments and create scaling figure.
    """
    input:
        "model_ignore_and_fire.py",
        "parameter_dict_ignore_and_fire.py",
        "scaling_ignore_and_fire.py"
    output:
        "figures/scaling.png"
    shell:
        "python3 scaling_ignore_and_fire.py"


rule clean:
    """
    Clean up generated figures and data files.
    """
    shell:
        "rm -f figures/*.png"
        "rm -rf data/*"
